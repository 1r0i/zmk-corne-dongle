#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&lt { flavor = "hold-preferred"; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        comma_quote: comma_quote {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUOTE";
            bindings = <&kp COMMA>, <&kp DOUBLE_QUOTES>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dot_quote: dot_quote {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_QUOTE";
            bindings = <&kp DOT>, <&kp SINGLE_QUOTE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        del_tab: del_tab {
            compatible = "zmk,behavior-mod-morph";
            label = "DEL_TAB";
            bindings = <&kp DELETE>, <&kp TAB>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        lt_del_tab: lt_del_tab {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_DEL_TAB";
            bindings = <&mo>, <&del_tab>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
        };

        lt_thumb_cluster: lt_thumb_cluster {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_THUMB_CLUSTER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
        };

        lt_home_row: lt_home_row {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_HOME_ROW";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
        };

        mt_home_row: mt_home_row {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_HOME_ROW";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        hangul {
            bindings = <&kp RALT>;
            key-positions = <46 43>;
            layers = <0>;
        };

        q {
            bindings = <&kp RS(Q)>;
            key-positions = <1 17>;
            layers = <0>;
        };

        w {
            bindings = <&kp RS(W)>;
            key-positions = <2 17>;
            layers = <0>;
        };

        e {
            bindings = <&kp RS(E)>;
            key-positions = <3 17>;
            layers = <0>;
        };

        r {
            bindings = <&kp RS(R)>;
            key-positions = <4 14>;
            layers = <0>;
        };

        t {
            bindings = <&kp RS(T)>;
            key-positions = <5 14>;
            layers = <0>;
        };

        o {
            bindings = <&kp LS(O)>;
            key-positions = <23 10>;
            layers = <0>;
        };

        p {
            bindings = <&kp LS(P)>;
            key-positions = <23 11>;
            layers = <0>;
        };

        quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <24 39>;
            layers = <0>;
        };

        double_quote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <38 25>;
            layers = <0>;
        };

        question_mark {
            bindings = <&kp QUESTION>;
            key-positions = <23 40>;
            layers = <0>;
        };

        exclamation {
            bindings = <&kp EXCLAMATION>;
            key-positions = <37 26>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB   &kp Q             &kp W                &kp E                 &kp R                 &kp T                                          &kp LG(L)                    &kp Y                    &kp U                 &kp I                 &kp O                &kp P             &kp DELETE
&kp BSPC  &lt_home_row 4 A  &mt_home_row LALT S  &mt_home_row LSHFT D  &mt_home_row LCTRL F  &kp G                        &kp C_AC_FORWARD  &kp CAPSLOCK  &kp C_AC_BACK  &kp H                    &mt_home_row LCTRL J  &mt_home_row LSHFT K  &mt_home_row LALT L  &lt_home_row 3 B  &kp BSPC
&kp LGUI  &kp Z             &kp X                &kp C                 &kp V                 &kp B            &mkp MB3                      &tog 6                       &kp N                    &kp M                 &comma_quote          &dot_quote           &kp FSLH          &kp ENTER
                                                 &kp LCTRL             &sk RSHFT             &lt_del_tab 1 0                                                             &lt_thumb_cluster 2 TAB  &kp SPACE             &kp ESC
            >;

            sensor-bindings = <&scroll_encoder>, <&rsr_trans>;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
&trans  &kp F1  &kp F2                      &kp F3                        &kp F4                       &kp F5                     &trans          &kp PERCENT  &kp MINUS                    &kp EQUAL                     &kp PLUS                    &kp ASTERISK  &trans
&trans  &kp N1  &mt_home_row LALT NUMBER_2  &mt_home_row LSHIFT NUMBER_3  &mt_home_row LCTRL NUMBER_4  &kp N5             &trans  &trans  &trans  &kp N6       &mt_home_row LCTRL NUMBER_7  &mt_home_row LSHIFT NUMBER_8  &mt_home_row LALT NUMBER_9  &kp N0        &trans
&trans  &kp F6  &kp F7                      &kp F8                        &kp F9                       &kp F10  &trans            &trans          &kp F11      &kp F12                      &trans                        &trans                      &trans        &trans
                                            &trans                        &trans                       &trans                                     &trans       &trans                       &trans
            >;

            sensor-bindings = <&scroll_encoder>, <&rsr_trans>;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
&trans  &kp EXCL        &kp QUESTION     &kp COLON          &kp SEMI        &kp PRCNT                        &trans          &kp CARET         &kp AMPS   &kp ASTRK  &kp PIPE              &kp AT_SIGN            &trans
&trans  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp EQUAL          &kp UNDERSCORE  &kp LESS_THAN            &trans  &trans  &trans  &kp GREATER_THAN  &kp MINUS  &kp PLUS   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &kp LBKT        &kp RBKT         &kp DOUBLE_QUOTES  &kp APOS        &kp HASH       &trans            &trans          &kp DOLLAR        &kp FSLH   &kp BSLH   &kp TILDE             &kp GRAVE              &trans
                                         &trans             &trans          &trans                                           &trans            &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>, <&rsr_trans>;
        };

        layer_3 {
            display-name = "Navi";
            bindings = <
&trans  &trans  &trans    &trans     &trans     &trans                        &trans          &kp PAGE_UP    &kp HOME         &kp UP          &kp END          &trans  &trans
&trans  &trans  &kp LALT  &kp LSHFT  &kp LCTRL  &kp K_MENU            &trans  &trans  &trans  &kp PAGE_DOWN  &kp LEFT         &kp DOWN        &kp RIGHT        &trans  &trans
&trans  &trans  &trans    &trans     &trans     &trans      &trans            &trans          &kp INSERT     &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK  &trans  &trans
                          &trans     &trans     &trans                                        &kp DELETE     &trans           &trans
            >;

            sensor-bindings = <&scroll_encoder>, <&rsr_trans>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &kp HOME         &kp UP          &kp END          &kp PAGE_UP                      &trans          &trans      &trans     &trans      &trans    &trans  &trans
&trans  &trans  &kp LEFT         &kp DOWN        &kp RIGHT        &kp PAGE_DOWN            &trans  &trans  &trans  &kp K_MENU  &kp LCTRL  &kp LSHIFT  &kp LALT  &trans  &trans
&trans  &trans  &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK  &kp INSERT     &trans            &trans          &trans      &trans     &trans      &trans    &trans  &trans
                                 &trans          &trans           &kp DELETE                                       &trans      &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        layer_5 {
            bindings = <
&trans  &trans  &mkp MB1        &mmv MOVE_UP    &mkp MB2         &mkp MB5                    &trans          &trans  &trans     &trans      &trans    &trans  &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB4            &trans  &trans  &trans  &trans  &kp LCTRL  &kp LSHIFT  &kp LALT  &trans  &trans
&trans  &trans  &msc SCRL_LEFT  &mkp MB3        &msc SCRL_RIGHT  &trans    &trans            &trans          &trans  &trans     &trans      &trans    &trans  &trans
                                &trans          &mkp MB1         &mkp MB2                                    &trans  &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        layer_6 {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T                          &kp UP               &kp Y          &kp U  &kp I      &kp O    &kp P     &kp ESC
&kp LCTRL  &kp A  &kp S  &kp D     &kp F  &kp G                &kp LEFT  &kp RET   &kp RIGHT  &kp H          &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V  &kp B      &trans              &kp DOWN             &kp N          &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                         &kp LALT  &mo 7  &kp SPACE                                           &kp BACKSPACE  &mo 7  &tog 6
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        layer_7 {
            bindings = <
&kp GRAVE  &trans        &trans        &trans        &trans        &trans                    &trans          &trans        &trans        &kp UP        &trans        &trans        &trans
&kp ESC    &trans        &trans        &trans        &trans        &trans            &trans  &trans  &trans  &trans        &kp LEFT      &kp DOWN      &kp RIGHT     &trans        &trans
&trans     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5  &trans            &trans          &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp ENTER
                                       &trans        &trans        &trans                                    &trans        &trans        &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };
    };
};
