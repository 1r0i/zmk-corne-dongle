#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&mt {
    tapping-term-ms = <250>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    flavor = "balanced";
};

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        comma_quote: comma_quote {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUOTE";
            bindings = <&kp COMMA>, <&kp DOUBLE_QUOTES>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dot_quote: dot_quote {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_QUOTE";
            bindings = <&kp DOT>, <&kp SINGLE_QUOTE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        hangul {
            bindings = <&kp RALT>;
            key-positions = <43 46>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&mt LGUI CAPSLOCK  &kp Q  &kp W       &kp E        &kp R        &kp T                               &kp UP               &kp Y      &kp U        &kp I         &kp O       &kp P     &mt LGUI DELETE
&kp BSPC           &kp A  &mt LALT S  &mt LSHFT D  &mt LCTRL F  &kp G                     &kp LEFT  &kp A     &kp RIGHT  &kp H      &mt LCTRL J  &mt LSHFT K   &mt LALT L  &lt 3 B   &kp BSPC
&kp TAB            &kp Z  &kp X       &kp C        &kp V        &kp B         &mkp MB3              &kp DOWN             &kp N      &kp M        &comma_quote  &dot_quote  &kp FSLH  &kp ENTER
                                      &kp LCTRL    &sk RSHIFT   &lt 1 DELETE                                             &lt 4 TAB  &lt 2 SPACE  &kp ESC
            >;

            sensor-bindings = <&scroll_encoder>, <&rsr_trans>;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
&trans  &kp F1  &kp F2             &kp F3               &kp F4              &kp F5                     &trans          &kp PERCENT  &kp MINUS           &kp EQUAL            &kp PLUS           &kp ASTERISK  &trans
&trans  &kp N1  &mt LALT NUMBER_2  &mt LSHIFT NUMBER_3  &mt LCTRL NUMBER_4  &kp N5             &trans  &trans  &trans  &kp N6       &mt LCTRL NUMBER_7  &mt LSHIFT NUMBER_8  &mt LALT NUMBER_9  &kp N0        &trans
&trans  &kp F6  &kp F7             &kp F8               &kp F9              &kp F10  &trans            &trans          &kp F11      &kp F12             &trans               &trans             &trans        &trans
                                   &trans               &trans              &mo 4                                      &mo 4        &trans              &trans
            >;

            sensor-bindings = <&scroll_encoder>, <&rsr_trans>;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
&trans  &kp EXCL        &kp QUESTION     &kp COLON          &kp SEMI        &kp PRCNT                        &trans          &kp CARET         &kp AMPS   &kp ASTRK  &kp PIPE              &kp AT_SIGN            &trans
&trans  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp EQUAL          &kp UNDERSCORE  &kp LESS_THAN            &trans  &trans  &trans  &kp GREATER_THAN  &kp MINUS  &kp PLUS   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &kp LBKT        &kp RBKT         &kp DOUBLE_QUOTES  &kp APOS        &kp HASH       &trans            &trans          &kp DOLLAR        &kp FSLH   &kp BSLH   &kp TILDE             &kp GRAVE              &trans
                                         &trans             &trans          &trans                                           &trans            &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>, <&rsr_trans>;
        };

        layer_3 {
            display-name = "Navi";
            bindings = <
&trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP     &mmv MOVE_RIGHT  &mkp MB5                    &trans          &kp PAGE_UP    &kp HOME         &kp UP          &kp END          &trans  &trans
&trans  &kp C_MENU      &kp LALT        &kp LSHFT        &kp LCTRL        &mkp MB4            &trans  &trans  &trans  &kp PAGE_DOWN  &kp LEFT         &kp DOWN        &kp RIGHT        &trans  &trans
&trans  &trans          &msc SCRL_LEFT  &msc SCRL_RIGHT  &trans           &mkp MB3  &trans            &trans          &kp INSERT     &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK  &trans  &trans
                                        &trans           &mkp MB1         &mkp MB2                                    &kp DELETE     &trans           &trans
            >;

            sensor-bindings = <&scroll_encoder>, <&rsr_trans>;
        };

        layer_4 {
            bindings = <
&trans  &studio_unlock  &trans  &trans  &trans  &trans                    &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans  &trans  &trans  &trans  &trans            &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans                                    &trans  &trans  &trans
            >;

            sensor-bindings = <&rgb_encoder>;
        };
    };
};
