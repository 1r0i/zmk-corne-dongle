#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&lt { flavor = "hold-preferred"; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        comma_quote: comma_quote {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUOTE";
            bindings = <&kp COMMA>, <&kp DOUBLE_QUOTES>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dot_quote: dot_quote {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_QUOTE";
            bindings = <&kp DOT>, <&kp SINGLE_QUOTE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        HRL: HRL {
            compatible = "zmk,behavior-hold-tap";
            label = "HRL";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            require-prior-idle-ms = <80>;
            quick-tap-ms = <150>;
        };

        HRM: HRM {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        hangul {
            bindings = <&kp RALT>;
            key-positions = <24 25>;
            layers = <0>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <17 32>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB         &kp Q     &kp W        &kp E         &kp R         &kp T                                    &kp LG(L)                    &kp Y  &kp U         &kp I            &kp O        &kp P     &kp DELETE
&kp BSPC        &HRL 4 A  &HRM LALT S  &HRM LSHFT D  &HRM LCTRL F  &kp G                  &kp C_AC_FORWARD  &kp CAPSLOCK  &kp C_AC_BACK  &kp H  &HRM LCTRL J  &HRM LSHIFT K    &HRM LALT L  &HRL 3 B  &kp BSPC
&mt LWIN ENTER  &kp Z     &kp X        &kp C         &kp V         &kp B      &mkp MB3                      &tog 6                       &kp N  &kp M         &comma_quote     &dot_quote   &kp FSLH  &kp ENTER
                                       &kp ESCAPE    &sk RSHFT     &lt 1 TAB                                                             &sl 2  &kp SPACE     &mt LWIN ESCAPE
            >;

            sensor-bindings = <&scroll_encoder>, <&rsr_trans>;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
&trans  &kp F1  &kp F2              &kp F3                &kp F4               &kp F5                     &trans          &kp PERCENT  &kp MINUS            &kp EQUAL             &kp PLUS            &kp ASTERISK  &trans
&trans  &kp N1  &HRM LALT NUMBER_2  &HRM LSHIFT NUMBER_3  &HRM LCTRL NUMBER_4  &kp N5             &trans  &trans  &trans  &kp N6       &HRM LCTRL NUMBER_7  &HRM LSHIFT NUMBER_8  &HRM LALT NUMBER_9  &kp N0        &trans
&trans  &kp F6  &kp F7              &kp F8                &kp F9               &kp F10  &trans            &trans          &kp F11      &kp F12              &trans                &trans              &trans        &trans
                                    &trans                &trans               &mo 5                                      &mo 5        &trans               &trans
            >;

            sensor-bindings = <&scroll_encoder>, <&rsr_trans>;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
&trans  &kp EXCL        &kp AT           &kp COLON  &kp SEMI        &kp PRCNT                            &trans          &kp CARET         &kp AMPS   &kp ASTRK  &kp PIPE              &kp BACKSLASH          &trans
&trans  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp EQUAL  &kp UNDERSCORE  &kp LESS_THAN                &trans  &trans  &trans  &kp GREATER_THAN  &kp MINUS  &kp PLUS   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &kp LBKT        &kp RBKT         &kp HASH   &kp DOLLAR      &kp DOUBLE_QUOTES  &trans            &trans          &kp SINGLE_QUOTE  &kp SLASH  &kp TILDE  &kp GRAVE             &kp QUESTION           &trans
                                         &trans     &trans          &mo 5                                                &mo 5             &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>, <&rsr_trans>;
        };

        layer_3 {
            display-name = "Navi";
            bindings = <
&trans  &trans  &trans    &trans     &trans     &trans                        &trans          &kp PAGE_UP    &kp HOME         &kp UP          &kp END          &trans  &bootloader
&trans  &trans  &kp LALT  &kp LSHFT  &kp LCTRL  &kp K_MENU            &trans  &trans  &trans  &kp PAGE_DOWN  &kp LEFT         &kp DOWN        &kp RIGHT        &trans  &trans
&trans  &trans  &trans    &trans     &kp RCTRL  &trans      &trans            &trans          &kp INSERT     &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK  &trans  &trans
                          &trans     &trans     &trans                                        &kp DELETE     &trans           &trans
            >;

            sensor-bindings = <&scroll_encoder>, <&rsr_trans>;
        };

        layer_4 {
            bindings = <
&bootloader  &trans  &kp HOME         &kp UP          &kp END          &kp PAGE_UP                      &trans          &trans      &trans     &trans      &trans    &trans  &trans
&trans       &trans  &kp LEFT         &kp DOWN        &kp RIGHT        &kp PAGE_DOWN            &trans  &trans  &trans  &kp K_MENU  &kp LCTRL  &kp LSHIFT  &kp LALT  &trans  &trans
&trans       &trans  &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK  &kp INSERT     &trans            &trans          &trans      &kp RCTRL  &trans      &trans    &trans  &trans
                                      &trans          &kp ENTER        &kp DELETE                                       &trans      &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_5 {
            bindings = <
&trans  &kp F5  &kp F6        &kp F7          &kp F8         &none                     &trans          &none   &kp F17         &kp F18          &kp F19        &kp F20  &trans
&trans  &kp F1  &HRM LALT F2  &HRM LSHIFT F3  &HRM LCTRL F4  &none             &trans  &trans  &trans  &none   &HRM LCTRL F13  &HRM LSHIFT F14  &HRM LALT F15  &kp F16  &trans
&trans  &kp F9  &kp F10       &kp F11         &kp F12        &none   &trans            &trans          &none   &kp F21         &kp F22          &kp F23        &kp F24  &trans
                              &trans          &trans         &trans                                    &trans  &trans          &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        layer_6 {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T                          &kp UP               &kp Y          &kp U  &kp I      &kp O    &kp P     &kp ESC
&kp LCTRL  &kp A  &kp S  &kp D     &kp F  &kp G                &kp LEFT  &kp RET   &kp RIGHT  &kp H          &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V  &kp B      &trans              &kp DOWN             &kp N          &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                         &kp LALT  &mo 7  &kp SPACE                                           &kp BACKSPACE  &mo 7  &tog 6
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        layer_7 {
            bindings = <
&kp GRAVE  &trans        &trans        &trans        &trans        &trans                    &trans          &trans        &trans        &kp UP        &trans        &trans        &trans
&kp ESC    &trans        &trans        &trans        &trans        &trans            &trans  &trans  &trans  &trans        &kp LEFT      &kp DOWN      &kp RIGHT     &trans        &trans
&trans     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5  &trans            &trans          &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp ENTER
                                       &trans        &trans        &trans                                    &trans        &trans        &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };
    };
};
