#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&lt { flavor = "hold-preferred"; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        HRM: HRM {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
        };

        HRL: HRL {
            compatible = "zmk,behavior-hold-tap";
            label = "HRL";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <80>;
            flavor = "balanced";
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        ctrl+v {
            bindings = <&kp LC(V)>;
            key-positions = <17 32>;
            layers = <0>;
        };
    };

    macros {
        alt_tab: alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mt LALT ESCAPE &mo 6>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mt LALT ESCAPE &mo 6>;

            label = "ALT_TAB";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp DELETE  &kp Q     &kp W        &kp E          &kp R         &kp T                             &kp UP                &kp Y  &kp U         &kp I          &kp O        &kp P      &kp DELETE
&kp LCTRL   &HRL 4 A  &HRM LALT S  &HRM LSHIFT D  &HRM LCTRL F  &kp G                   &kp LEFT  &kp ENTER  &kp RIGHT  &kp H  &HRM LCTRL J  &HRM LSHIFT K  &HRM LALT L  &HRL 5 B   &kp BACKSPACE
&kp LGUI    &kp Z     &kp X        &kp C          &kp V         &kp SLASH  &kp SPACE              &kp DOWN              &kp N  &kp M         &kp COMMA      &kp DOT      &kp ENTER  &kp RALT
                                   &alt_tab       &sk RSHIFT    &lt 1 TAB                                               &sl 2  &kp SPACE     &kp ESCAPE
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
&trans  &kp F1  &kp F2              &kp F3                &kp F4               &kp F5                     &trans          &kp PERCENT  &kp MINUS            &kp PLUS              &kp ASTERISK        &kp EQUAL  &trans
&trans  &kp N1  &HRM LALT NUMBER_2  &HRM LSHIFT NUMBER_3  &HRM LCTRL NUMBER_4  &kp N5             &trans  &trans  &trans  &kp N6       &HRM LCTRL NUMBER_7  &HRM LSHIFT NUMBER_8  &HRM LALT NUMBER_9  &kp N0     &trans
&trans  &kp F6  &kp F7              &kp F8                &kp F9               &kp F10  &trans            &trans          &kp F11      &kp F12              &trans                &trans              &trans     &trans
                                    &trans                &trans               &mo 3                                      &mo 3        &trans               &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
&trans  &kp SLASH        &kp LESS_THAN  &kp GREATER_THAN  &kp EQUAL          &kp PIPE                         &trans          &kp CARET    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DOLLAR        &kp BACKSLASH  &trans
&trans  &kp EXCLAMATION  &kp COLON      &kp PLUS          &kp MINUS          &kp AMPERSAND            &trans  &trans  &trans  &kp HASH     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON     &kp GRAVE      &trans
&trans  &kp TILDE        &kp ASTERISK   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PERCENT    &trans            &trans          &kp AT_SIGN  &kp UNDERSCORE        &kp DOUBLE_QUOTES      &kp SINGLE_QUOTE  &kp QUESTION   &trans
                                        &trans            &trans             &mo 3                                            &mo 3        &trans                &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_3 {
            display-name = "Fn";
            bindings = <
&trans  &kp F1  &kp F2  &kp F3   &kp F4   &none                     &trans          &none   &kp F13  &kp F14  &kp F15  &kp F16  &trans
&trans  &kp F4  &kp F5  &kp F6   &kp F7   &none             &trans  &trans  &trans  &none   &kp F17  &kp F18  &kp F19  &kp F20  &trans
&trans  &kp F8  &kp F9  &kp F10  &kp F11  &none   &trans            &trans          &none   &kp F21  &kp F22  &kp F23  &kp F24  &trans
                        &trans   &trans   &trans                                    &trans  &trans   &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        left_navi {
            bindings = <
&bootloader  &trans  &kp HOME        &kp UP_ARROW    &kp END          &kp PAGE_UP                      &trans          &trans        &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK  &trans  &trans
&trans       &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAGE_DOWN            &trans  &trans  &trans  &kp CAPSLOCK  &kp LCTRL        &kp LSHIFT      &kp LALT         &trans  &trans
&sys_reset   &trans  &kp K_MENU      &kp BACKSPACE   &kp DELETE       &kp INSERT     &trans            &trans          &trans        &kp RCTRL        &kp RSHIFT      &kp RALT         &trans  &trans
                                     &kp ESCAPE      &kp ENTER        &kp TAB                                          &trans        &trans           &trans
            >;
        };

        right_navi {
            bindings = <
&trans  &trans  &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK  &trans                          &trans          &kp PAGE_UP    &kp HOME        &kp UP_ARROW    &kp END          &trans  &bootloader
&trans  &trans  &kp LALT         &kp LSHIFT      &kp LCTRL        &kp CAPSLOCK            &trans  &trans  &trans  &kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &trans  &kp RALT         &kp RSHIFT      &kp RCTRL        &trans        &trans            &trans          &kp INSERT     &kp DELETE      &kp BACKSPACE   &kp K_MENU       &trans  &sys_reset
                                 &trans          &trans           &trans                                          &kp TAB        &trans          &trans
            >;
        };

        alt_tab {
            bindings = <
&trans  &trans  &trans          &kp UP_ARROW    &trans   &trans                    &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp TAB  &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans          &trans          &trans   &trans  &trans            &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                &trans          &trans   &trans                                    &trans  &trans  &trans
            >;
        };
    };
};
